# BOW Sports Capital — environment variables
# Copy to `.env.local` for local dev, or set these in your host's dashboard.
# Every value below has a safe in-code default, so the app runs without a .env;
# set them explicitly before a real deploy.

# Canonical public origin, used for <metadata> URLs, robots.txt, and sitemap.xml.
# No trailing slash.
NEXT_PUBLIC_SITE_URL=https://bowsportscapital.com

# Development password assigned to seeded demo accounts on first boot.
# Rotate or remove this for any non-demo deployment.
SEED_PASSWORD=bowdemo123
