# BOW Sports Capital — environment variables
# Copy to `.env.local` for local dev, or set these in your host's dashboard.
# Local development runs without a .env. Production bootstrap values have no
# fallback and must be supplied through the host's encrypted environment store.

# Canonical public origin, used for <metadata> URLs, robots.txt, and sitemap.xml.
# No trailing slash.
NEXT_PUBLIC_SITE_URL=https://bowsportscapital.com

# Transactional email uses this canonical server-side origin to build invitation
# and password-reset links. It must be HTTPS with no path, query, or hash.
BOW_APP_URL=https://bowsportscapital.com

# Invitation and password-reset delivery through the Resend REST API. The
# sending domain must be verified in Resend. BOW_RESET_EMAIL_FROM remains a
# backwards-compatible fallback when BOW_EMAIL_FROM is not set.
RESEND_API_KEY=re_replace-with-a-secret-from-your-password-manager
BOW_EMAIL_FROM="BOW Sports Capital <hello@bowsportscapital.com>"
# BOW_RESET_EMAIL_FROM="BOW Sports Capital <security@bowsportscapital.com>"

# Local development only. When true (and never in production), a reset link may
# be shown after a request so the workflow can be tested without sending mail.
BOW_REVEAL_RESET_LINKS=false

# Optional network rate-limit bucket. Set this only when a trusted reverse proxy
# replaces the named header with one canonical client IP (never a forwarded
# chain). Invalid configured values fail closed. If unset, identity-based limits
# remain active and forwarding headers are ignored.
BOW_TRUSTED_CLIENT_IP_HEADER=

# Optional development password assigned to local demo accounts on first boot.
# Production never seeds demo identities or content.
SEED_PASSWORD=generate-a-long-random-development-password

# One-time bootstrap identity for a brand-new production database. The password
# must be unique and at least 16 characters; the account is required to rotate it.
BOW_BOOTSTRAP_ADMIN_EMAIL=founder@example.org
BOW_BOOTSTRAP_ADMIN_NAME=BOW Founder
BOW_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-secret-from-your-password-manager

# Supabase Postgres. The Vercel Marketplace integration supplies POSTGRES_URL
# automatically. Use the transaction-pooled URL (port 6543) for the app.
POSTGRES_URL=postgres://postgres.project-ref:password@region.pooler.supabase.com:6543/postgres

# One-time migrations should use Supabase's direct/session URL (port 5432).
# Do not expose either value with a NEXT_PUBLIC_ prefix.
POSTGRES_URL_NON_POOLING=postgres://postgres.project-ref:password@region.pooler.supabase.com:5432/postgres

# Editorial redundancy uses two different Blob stores. The public token may
# contain published, identity-free article payloads. The private token must be
# provisioned from a separate store configured with private access.
BLOB_READ_WRITE_TOKEN=public-article-store-token
ARTICLE_PRIVATE_BLOB_READ_WRITE_TOKEN=private-article-store-token

# Stage 11 controlled cutover switch for the student learn platform. Default
# is ON (any value other than "off" counts as ON): /app/student, /app/student/track,
# and /app/student/lesson redirect to /dashboard, and student nav Home points
# at /dashboard. Set to "off" to instantly roll back to the legacy cohort
# portal without a redeploy — see lib/learn/cutover.ts and
# docs/learn/stage11-cutover.md.
BOW_LEARN_CUTOVER=on
